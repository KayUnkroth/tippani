    "cleanup": {
      "manifestId": "see-run-preflights",
      "expiresAt": "see-run-preflights"
    },
    "effectiveTargetHash": "see-run-preflights",
    "approval": null
  },
  "budgets": {
    "maxOperations": 500,
    "maxDurationMs": 300000,
    "maxObjects": 10000,
    "maxBytes": 104857600
  }
}

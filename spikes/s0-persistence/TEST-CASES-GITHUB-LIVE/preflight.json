{
  "configurationId": "CFG-GITHUB-LIVE",
  "runId": "cfg-github-live-aggregate",
  "adapter": "github",
  "backingPath": "github",
  "syntheticDataOnly": true,
  "sandbox": {
    "approved": true,
    "kind": "provider-live",
    "identityLabel": "One GitHub identity (supplied at runtime)",
    "identityVerified": true,
    "providerIdentity": "github:MDQ6VXNlcjMwMjY4Nzkz",
    "ownershipMarker": "redacted-per-run",
    "namespace": "redacted-per-run",
    "defaultBranchExcluded": true,
    "corporateFallbackDisabled": true,
    "dryRunOperations": [
      "connect",
      "put-run-marker",
